{
  "name": "markdown-styler",
  "title": "Markdown Styler",
  "description": "Convert Markdown to styled HTML with inline CSS for content platforms",
  "icon": "command-icon.png",
  "author": "almatkai",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "mp-style-markdown",
      "title": "Style Markdown",
      "subtitle": "Convert to Styled Format",
      "description": "Convert Markdown to styled HTML with inline CSS for content platforms",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "marked": "^9.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.markdown-styler",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/markdown-styler",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/markdown-styler",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
